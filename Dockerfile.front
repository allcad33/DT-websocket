# Use a lightweight Node.js base image
FROM node:22-alpine

# Set the working directory
WORKDIR /app

# Copy the build folder from the admin directory
COPY admin/build/ /app/build

# Install serve globally (optimized)
RUN npm install -g serve --omit=dev

# Expose the port 3020
EXPOSE 3020

# Use serve to serve the static frontend on port 3020
CMD ["serve", "-s", "build", "-l", "3020"]
